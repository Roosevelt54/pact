# Rail: `local` (in-process ledger, no chain) or `tempo` (Tempo Moderato TIP-1034 escrow).
# `npm run tempo:setup` generates and faucet-funds testnet keys and writes them to .env.
PACT_RAIL=local

PACT_API_PORT=8787
PACT_PUBLIC_URL=http://localhost:8787
PACT_WEB_ORIGIN=http://localhost:3000
PACT_DB_PATH=./data/pact.db

# >= 32 chars. Binds MPP challenge ids to this gateway (HMAC). Required to be unique in production.
MPP_SECRET_KEY=

# Protects POST /v1/admin/recover
PACT_ADMIN_TOKEN=

TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_TOKEN=0x20c0000000000000000000000000000000000000

# Testnet only. Never commit real keys.
PACT_OPERATOR_PRIVATE_KEY=
DEMO_AGENT_PRIVATE_KEY=
DEMO_PROVIDER_PRIVATE_KEY=
DEMO_PROVIDER_B_PRIVATE_KEY=
